{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyLoDB",
  "version": "0.11.0",
  "identifier": "dev.mylodb.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "MyLoDB", "width": 1280, "height": 800, "minWidth": 900, "minHeight": 600 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUzRDE3MDZFOTg3RTdDNTgKUldSWWZINllibkRSVTJpRnB3RTBCNzhQUnRvT3Rvc0RCMjk4emFZeTFUdzhEeGZXYjBVSWc4V3UK",
      "endpoints": ["https://github.com/farookhridoy/mylodb/releases/latest/download/latest.json"]
    }
  }
}
